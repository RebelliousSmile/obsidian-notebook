{
	"name": "obsidian-handbook",
	"version": "2.8.6",
	"description": "Game-specific themes and tools for Obsidian tabletop roleplaying vaults.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "node tools/check.mjs",
		"lint": "eslint .",
		"assert:game-storage": "node tools/assert-game-storage.mjs",
		"assert:github-sources": "node tools/assert-github-sources.mjs",
		"assert:custom-packs": "node tools/assert-custom-packs.mjs",
		"assert:repository-manifest": "node tools/assert-repository-manifest.mjs",
		"assert:source-installer": "node tools/assert-source-installer.mjs",
		"assert:starter-kits": "node tools/assert-starter-kits.mjs",
		"e2e:request-url": "bash tools/e2e/request-url-journey.sh",
		"assert:game-variants": "node tools/assert-game-variants.mjs",
		"assert:settings-ui": "node tools/assert-settings-ui.mjs",
		"assert:reload-styles": "node tools/assert-reload-styles.mjs",
		"assert:style-scope": "node tools/assert-style-scope.mjs",
		"assert:callouts": "node tools/assert-callouts.mjs",
		"assert:note-background": "node tools/assert-note-background.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"city of mist",
		"legend in the mist",
		"adrenaline system",
		"ttrpg",
		"roleplaying",
		"game"
	],
	"author": "François-Xavier Guillois",
	"license": "MIT",
	"dependencies": {
		"obsidian": "^1.12.3",
		"postcss": "8.5.6",
		"postcss-selector-parser": "7.1.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.30.1",
		"@types/node": "^16.18.126",
		"@typescript-eslint/parser": "^8.69.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.0",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^9.30.1",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-obsidianmd": "^0.2.3",
		"globals": "^17.5.0",
		"obsidian": "^1.12.3",
		"sass": "^1.99.0",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2"
	}
}
